<Window x:Class="Capri.Desktop.Views.CharacterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:Capri.Desktop.Controls"
        mc:Ignorable="d"
        Title="Capri"
        Width="250" Height="300"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ShowActivated="False"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        Visibility="Collapsed"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">
    <!-- Null window/grid background allows click-through outside rendered character elements (best effort). -->
    <Grid x:Name="Root" Background="{x:Null}">
        <controls:AvatarControl x:Name="Avatar"
                                Width="240" Height="280"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Bottom"
                                Cursor="Hand"
                                IsHitTestVisible="True"
                                ToolTip="Capri — click to chat, drag to move"
                                MouseLeftButtonDown="Avatar_MouseLeftButtonDown"
                                MouseLeftButtonUp="Avatar_MouseLeftButtonUp"
                                MouseMove="Avatar_MouseMove"
                                ContextMenuOpening="Avatar_ContextMenuOpening">
            <controls:AvatarControl.ContextMenu>
                <ContextMenu>
                    <MenuItem Tag="VoiceStart" Header="Start listening (Hey Capri)..."
                              Click="StartVoice_Click" ToolTip="Opens chat and asks for microphone permission"/>
                    <MenuItem Tag="VoiceStop" Header="Stop listening"
                              Click="StopVoice_Click" IsEnabled="False"/>
                    <Separator/>
                    <MenuItem Header="Appear" Tag="Appear" Click="AvatarGesture_Click"/>
                    <MenuItem Header="Disappear / hide" Tag="Disappear" Click="AvatarGesture_Click"/>
                    <Separator/>
                    <MenuItem Header="Look and react">
                        <MenuItem Header="Look left" Tag="LookLeft" Click="AvatarGesture_Click"/>
                        <MenuItem Header="Look right" Tag="LookRight" Click="AvatarGesture_Click"/>
                        <MenuItem Header="Look around" Tag="LookAround" Click="AvatarGesture_Click"/>
                        <MenuItem Header="Turn towards screen (animation only)" Tag="TurnToScreen"
                                  ToolTip="This is a visual gesture; it does not capture or inspect your screen."
                                  Click="AvatarGesture_Click"/>
                        <MenuItem Header="Lean closer" Tag="LeanIn" Click="AvatarGesture_Click"/>
                        <MenuItem Header="Nod" Tag="Nod" Click="AvatarGesture_Click"/>
                        <MenuItem Header="Shake head" Tag="Shake" Click="AvatarGesture_Click"/>
                    </MenuItem>
                    <MenuItem Header="Move and celebrate">
                        <MenuItem Header="Step left" Tag="WalkLeft" Click="AvatarGesture_Click"/>
                        <MenuItem Header="Step right" Tag="WalkRight" Click="AvatarGesture_Click"/>
                        <MenuItem Header="Hop" Tag="Hop" Click="AvatarGesture_Click"/>
                        <MenuItem Header="Jump" Tag="Jump" Click="AvatarGesture_Click"/>
                        <MenuItem Header="Wave (body gesture)" Tag="Wave" Click="AvatarGesture_Click"/>
                        <MenuItem Header="Celebrate" Tag="Celebrate" Click="AvatarGesture_Click"/>
                    </MenuItem>
                    <MenuItem Header="Facial clips (need artwork)">
                        <MenuItem Header="Blink" Tag="Blink" Click="AvatarGesture_Click"/>
                        <MenuItem Header="Side-eye" Tag="SideEye" Click="AvatarGesture_Click"/>
                        <MenuItem Header="Talk mouth" Tag="MouthSpeak" Click="AvatarGesture_Click"/>
                    </MenuItem>
                </ContextMenu>
            </controls:AvatarControl.ContextMenu>
        </controls:AvatarControl>
        <Border x:Name="VoiceInactiveBadge" Visibility="Collapsed" IsHitTestVisible="False"
                HorizontalAlignment="Left" VerticalAlignment="Top"
                Margin="6,5,0,0" Padding="7,4"
                BorderBrush="#88D4A1FF" BorderThickness="1"
                Background="#EE101015" CornerRadius="6"
                ToolTip="Voice is enabled in Settings, but the microphone is OFF. Right-click Capri and choose Start listening.">
            <TextBlock Foreground="#FFC7B9DE" FontSize="10" Text="MIC OFF — right-click"/>
        </Border>
        <Border x:Name="VoiceActiveBadge" Visibility="Collapsed" IsHitTestVisible="False"
                HorizontalAlignment="Left" VerticalAlignment="Top"
                Margin="6,5,0,0" Padding="7,4"
                BorderBrush="#FF388FFF" BorderThickness="1"
                Background="#EE101015" CornerRadius="6"
                ToolTip="Microphone active. Right-click Capri and choose Stop listening to turn it off.">
            <TextBlock Foreground="#FF388FFF" FontSize="10" FontWeight="Bold" Text="● MIC ON"/>
        </Border>
        <Border x:Name="WebcamActiveBadge" Visibility="Collapsed"
                HorizontalAlignment="Right" VerticalAlignment="Top"
                Margin="0,5,6,0" Padding="7,4"
                BorderBrush="#FF00FF65" BorderThickness="1"
                Background="#EE101015" CornerRadius="6"
                ToolTip="Webcam awareness is enabled. Click Capri to open chat and pause or stop.">
            <TextBlock Foreground="#FF00FF65" FontSize="10" FontWeight="Bold" Text="● CAM ON"/>
        </Border>
    </Grid>
</Window>
