<Window x:Class="Capri.Desktop.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Capri Settings"
        Width="560" Height="680"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#101015"
        Foreground="#F8F5FF">
    <Window.Resources>
        <SolidColorBrush x:Key="Bg" Color="#101015"/>
        <SolidColorBrush x:Key="Surface" Color="#1A1822"/>
        <SolidColorBrush x:Key="Surface2" Color="#221F2D"/>
        <SolidColorBrush x:Key="Border" Color="#55FF176C"/>
        <SolidColorBrush x:Key="BorderSoft" Color="#334A4060"/>
        <SolidColorBrush x:Key="Magenta" Color="#FF176C"/>
        <SolidColorBrush x:Key="Green" Color="#00FF65"/>
        <SolidColorBrush x:Key="Blue" Color="#388FFF"/>
        <SolidColorBrush x:Key="Text" Color="#F8F5FF"/>
        <SolidColorBrush x:Key="Dim" Color="#B8B0C8"/>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource Surface2}"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderSoft}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Margin" Value="0,2,0,8"/>
            <Setter Property="CaretBrush" Value="{StaticResource Text}"/>
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Background" Value="{StaticResource Surface2}"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderSoft}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="CaretBrush" Value="{StaticResource Text}"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#2A2235"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="Expander">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="Background" Value="{StaticResource Surface}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderSoft}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="IsExpanded" Value="False"/>
        </Style>
        <Style TargetType="GroupBox">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderSoft}"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Padding" Value="10"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Margin" Value="0,2,0,8"/>
            <Setter Property="Padding" Value="6,4"/>
        </Style>
        <Style TargetType="Slider">
            <Setter Property="Margin" Value="0,2,0,8"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="16">
            <StackPanel>
                <DockPanel Margin="0,0,0,14">
                    <Ellipse Width="10" Height="10" Fill="{StaticResource Green}" Margin="0,0,8,0" VerticalAlignment="Center" DockPanel.Dock="Left"/>
                    <TextBlock Text="Capri Settings" FontSize="20" FontWeight="SemiBold"/>
                </DockPanel>

                <Expander IsExpanded="True">
                    <Expander.Header>
                        <TextBlock Text="AI providers" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource Magenta}"/>
                    </Expander.Header>
                    <Border Background="{StaticResource Surface2}" CornerRadius="8" Padding="12" Margin="0,4,0,0">
                        <StackPanel>
                            <TextBlock Text="Provider preset" Foreground="{StaticResource Dim}"/>
                            <ComboBox ItemsSource="{Binding Presets}" SelectedItem="{Binding SelectedPreset}" DisplayMemberPath="DisplayName"/>
                            <TextBlock Text="Provider ID" Foreground="{StaticResource Dim}"/>
                            <TextBox Text="{Binding ProviderId, UpdateSourceTrigger=LostFocus}"/>
                            <TextBlock Text="Base URL" Foreground="{StaticResource Dim}"/>
                            <TextBox Text="{Binding BaseUrl, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Text="Model" Foreground="{StaticResource Dim}"/>
                            <TextBox Text="{Binding ChatModel, UpdateSourceTrigger=PropertyChanged}"/>
                            <DockPanel Margin="0,0,0,4">
                                <Button Content="Refresh models" Command="{Binding RefreshModelsCommand}" Padding="8,2" DockPanel.Dock="Right"
                                        Margin="8,0,0,0"/>
                                <TextBlock Text="Discovered models (selectable list)" Foreground="{StaticResource Dim}" VerticalAlignment="Center"/>
                            </DockPanel>
                            <ComboBox ItemsSource="{Binding AvailableModels}" SelectedItem="{Binding SelectedDiscoveredModel}"/>
                            <TextBlock Text="{Binding ModelDiscoveryStatus}" Foreground="{StaticResource Blue}" FontSize="11" Margin="0,0,0,8"/>
                            <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource BorderSoft}" BorderThickness="1"
                                    CornerRadius="6" Padding="8" Margin="0,2,0,8">
                                <StackPanel>
                                    <TextBlock Text="Cloud consent and free-only safety" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                    <CheckBox Content="Allow cloud inference (explicit consent)" IsChecked="{Binding AllowCloudInference}"/>
                                    <CheckBox Content="Free models only (never auto-select a paid model)" IsChecked="{Binding FreeModelsOnly}"/>
                                    <TextBlock Text="{Binding CloudConsentWarning}" Foreground="#FFB347" FontWeight="SemiBold" Margin="0,2,0,2"/>
                                    <TextBlock Text="{Binding FreeModelsOnlyHint}" Foreground="#FFB347" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>
                            <CheckBox Content="Enable streaming" IsChecked="{Binding EnableStreaming}"/>
                            <UniformGrid Columns="2" Margin="0,0,0,0">
                                <StackPanel Margin="0,0,8,0">
                                    <TextBlock Text="Temperature" Foreground="{StaticResource Dim}"/>
                                    <TextBox Text="{Binding Temperature, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="Max output tokens" Foreground="{StaticResource Dim}"/>
                                    <TextBox Text="{Binding MaxOutputTokens, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                            </UniformGrid>
                            <TextBlock Text="Request timeout (seconds)" Foreground="{StaticResource Dim}"/>
                            <TextBox Text="{Binding RequestTimeoutSeconds, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,10"/>
                            <TextBlock Text="API key (stored securely per provider profile)" FontWeight="SemiBold"/>
                            <PasswordBox x:Name="ApiKeyBox" Margin="0,2,0,4" IsEnabled="{Binding CanEditApiKey}"
                                         PasswordChanged="ApiKeyBox_PasswordChanged"/>
                            <DockPanel Margin="0,0,0,4">
                                <Button Content="Clear stored key" Command="{Binding ClearApiKeyCommand}" Padding="8,2" DockPanel.Dock="Right"
                                        IsEnabled="{Binding CanEditApiKey}" Click="ClearStoredKeyButton_Click"/>
                                <TextBlock Text="{Binding ApiKeyStatus}" VerticalAlignment="Center" Foreground="{StaticResource Blue}"/>
                            </DockPanel>
                            <TextBlock Text="{Binding ApiKeyHelpText}" FontSize="11" Foreground="{StaticResource Dim}"/>
                        </StackPanel>
                    </Border>
                </Expander>

                <Expander>
                    <Expander.Header>
                        <TextBlock Text="Voice / mic" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource Magenta}"/>
                    </Expander.Header>
                    <Border Background="{StaticResource Surface2}" CornerRadius="8" Padding="12" Margin="0,4,0,0">
                        <StackPanel>
                            <TextBlock Text="Voice and microphone preferences. Voice wiring depends on enabled integrations." Foreground="{StaticResource Dim}" Margin="0,0,0,8"/>
                            <CheckBox Content="Enable microphone input (integration-dependent)" IsChecked="False" IsEnabled="False"/>
                            <CheckBox Content="Enable text-to-speech responses (integration-dependent)" IsChecked="False" IsEnabled="False"/>
                            <TextBlock Text="Input device" Foreground="{StaticResource Dim}"/>
                            <ComboBox IsEnabled="False" SelectedIndex="0">
                                <ComboBoxItem Content="System default (placeholder)"/>
                            </ComboBox>
                        </StackPanel>
                    </Border>
                </Expander>

                <Expander>
                    <Expander.Header>
                        <TextBlock Text="Character / animations" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource Magenta}"/>
                    </Expander.Header>
                    <Border Background="{StaticResource Surface2}" CornerRadius="8" Padding="12" Margin="0,4,0,0">
                        <StackPanel>
                            <TextBlock Text="Capri visual states: Idle, Listening, Thinking, Talking, Happy/Success, Annoyed/Error, Surprised, Sleep." Foreground="{StaticResource Dim}" Margin="0,0,0,8"/>
                            <CheckBox Content="Reduce motion (uses calmer transitions when supported)" IsChecked="{Binding ReduceMotion}" ToolTip="Saved UI preference for avatar presentation."/>
                            <CheckBox Content="Show idle blink/movement" IsChecked="True" IsEnabled="False" ToolTip="Default character behavior."/>
                        </StackPanel>
                    </Border>
                </Expander>

                <Expander IsExpanded="True">
                    <Expander.Header>
                        <TextBlock Text="Windows automation permissions" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource Magenta}"/>
                    </Expander.Header>
                    <Border Background="{StaticResource Surface2}" CornerRadius="8" Padding="12" Margin="0,4,0,0">
                        <StackPanel>
                            <CheckBox Content="Enable automation" IsChecked="{Binding AutomationEnabled}"/>
                            <CheckBox Content="Allow app launch" IsChecked="{Binding AllowAppLaunch}"/>
                            <CheckBox Content="Allow opening websites" IsChecked="{Binding AllowWebLaunch}"/>
                            <CheckBox Content="Allow media controls" IsChecked="{Binding AllowMediaControl}"/>
                        </StackPanel>
                    </Border>
                </Expander>

                <Expander>
                    <Expander.Header>
                        <TextBlock Text="Appearance / sizing" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource Magenta}"/>
                    </Expander.Header>
                    <Border Background="{StaticResource Surface2}" CornerRadius="8" Padding="12" Margin="0,4,0,0">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,2">
                                <TextBlock Text="{Binding CharacterHeight, StringFormat=Character height: {0}px}" Foreground="{StaticResource Text}"/>
                            </DockPanel>
                            <TextBlock Text="Adjust Capri's visible character height (150–400 px). Saved with settings." Foreground="{StaticResource Dim}" Margin="0,0,0,4"/>
                            <Slider Minimum="150" Maximum="400" Value="{Binding CharacterHeight, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    IsSnapToTickEnabled="True" TickFrequency="10" SmallChange="10" LargeChange="25"/>
                        </StackPanel>
                    </Border>
                </Expander>

                <Expander>
                    <Expander.Header>
                        <TextBlock Text="Startup preferences" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource Magenta}"/>
                    </Expander.Header>
                    <Border Background="{StaticResource Surface2}" CornerRadius="8" Padding="12" Margin="0,4,0,0">
                        <StackPanel>
                            <TextBlock Text="Startup behavior is controlled by existing app settings where available." Foreground="{StaticResource Dim}" Margin="0,0,0,8"/>
                            <CheckBox Content="Start minimized to tray / show companion on launch (controlled by saved UI settings)" IsChecked="True" IsEnabled="False"/>
                        </StackPanel>
                    </Border>
                </Expander>

                <Expander>
                    <Expander.Header>
                        <TextBlock Text="Privacy / screen control" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource Magenta}"/>
                    </Expander.Header>
                    <Border Background="{StaticResource Surface2}" CornerRadius="8" Padding="12" Margin="0,4,0,0">
                        <StackPanel>
                            <TextBlock Text="Sensitive controls should remain explicit. Screen-control/automation features require appropriate permissions and may be integration-dependent." Foreground="{StaticResource Dim}" Margin="0,0,0,8"/>
                            <CheckBox Content="Allow screen-aware assistance (integration-dependent)" IsChecked="False" IsEnabled="False"/>
                            <CheckBox Content="Confirm before sensitive automation actions" IsChecked="True" IsEnabled="False"/>
                        </StackPanel>
                    </Border>
                </Expander>

                <Border Background="{StaticResource Surface}" CornerRadius="8" Padding="10" BorderBrush="{StaticResource BorderSoft}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Health check (connectivity only)" FontSize="11" Foreground="{StaticResource Dim}"/>
                        <TextBlock Text="{Binding TestConnectionStatus}" Foreground="{StaticResource Green}" Margin="0,0,0,6"/>
                        <TextBlock Text="Inference test (real chat request)" FontSize="11" Foreground="{StaticResource Dim}"/>
                        <TextBlock Text="{Binding TestInferenceStatus}" Foreground="{StaticResource Green}" Margin="0,0,0,6"/>
                        <TextBlock Text="{Binding SaveStatus}" Foreground="{StaticResource Blue}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="1" Background="#15131C" BorderBrush="#33FF176C" BorderThickness="0,1,0,0" Padding="16,10">
            <WrapPanel HorizontalAlignment="Right">
                <Button Content="Check connection (health only)" Command="{Binding TestConnectionCommand}" Margin="0,0,8,0"/>
                <Button Content="Test inference" Command="{Binding TestInferenceCommand}" Margin="0,0,8,0"/>
                <Button Content="Save" Margin="0,0,8,0" Click="SaveButton_Click" BorderBrush="{StaticResource Magenta}"/>
                <Button Content="Cancel" IsCancel="True"/>
            </WrapPanel>
        </Border>
    </Grid>
</Window>
