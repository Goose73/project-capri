<Window x:Class="Capri.Desktop.Views.ChatPanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Capri.Desktop.ViewModels"
        xmlns:controls="clr-namespace:Capri.Desktop.Controls"
        mc:Ignorable="d"
        Title="Capri Chat"
        Width="410" Height="620"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ShowActivated="True"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        Visibility="Collapsed"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <SolidColorBrush x:Key="PanelBg" Color="#FA101015"/>
        <SolidColorBrush x:Key="SurfaceBg" Color="#F41A1822"/>
        <SolidColorBrush x:Key="InputBg" Color="#F8151320"/>
        <SolidColorBrush x:Key="Magenta" Color="#FF176C"/>
        <SolidColorBrush x:Key="FaceGreen" Color="#00FF65"/>
        <SolidColorBrush x:Key="EyeBlue" Color="#388FFF"/>
        <SolidColorBrush x:Key="Outline" Color="#150B19"/>
        <SolidColorBrush x:Key="TextMain" Color="#F8F5FF"/>
        <SolidColorBrush x:Key="TextDim" Color="#B8B0C8"/>

        <Style x:Key="DarkButton" TargetType="Button">
            <Setter Property="Background" Value="#2A2235"/>
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
            <Setter Property="BorderBrush" Value="#55FF176C"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#AAFF176C"/>
                                <Setter TargetName="Bd" Property="Background" Value="#352844"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#442D55"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource DarkButton}">
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="MinWidth" Value="34"/>
            <Setter Property="ToolTipService.InitialShowDelay" Value="300"/>
        </Style>

        <DataTemplate DataType="{x:Type vm:ChatMessageViewModel}">
            <Border Margin="0,4" Padding="9,7" CornerRadius="10" MaxWidth="300">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="#CC232033"/>
                        <Setter Property="BorderBrush" Value="#334A4060"/>
                        <Setter Property="BorderThickness" Value="1"/>
                        <Setter Property="HorizontalAlignment" Value="Left"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Role}" Value="You">
                                <Setter Property="Background" Value="#55388FFF"/>
                                <Setter Property="BorderBrush" Value="#77388FFF"/>
                                <Setter Property="HorizontalAlignment" Value="Right"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsError}" Value="True">
                                <Setter Property="Background" Value="#44FF176C"/>
                                <Setter Property="BorderBrush" Value="#88FF176C"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock Text="{Binding Role}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource FaceGreen}" Opacity="0.9"/>
                    <controls:MarkdownMessageTextBlock Markdown="{Binding Text}"
                             TextWrapping="Wrap" Foreground="{StaticResource TextMain}"
                             Margin="0,4,0,0"
                             ToolTip="Formatted chat text. Right-click to copy the original message."/>
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Border CornerRadius="16" Background="{StaticResource PanelBg}" BorderBrush="#99FF176C" BorderThickness="1.5" Padding="10">
        <Border.Effect>
            <DropShadowEffect Color="#FF176C" BlurRadius="14" ShadowDepth="0" Opacity="0.18"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" Margin="0,0,0,6" LastChildFill="False">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <Ellipse Width="8" Height="8" Fill="{StaticResource FaceGreen}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Capri" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextMain}"/>
                    <Button Content="Dev" Style="{StaticResource DarkButton}" Padding="7,2" Margin="12,0,0,0" FontSize="11"
                            ToolTip="Open the developer workspace" Click="DeveloperWorkspace_Click"/>
                    <TextBlock x:Name="VoiceIndicator" Text="MIC OFF" Margin="9,0,0,0"
                               VerticalAlignment="Center" FontSize="10"
                               Foreground="{StaticResource TextDim}"
                               ToolTip="The microphone is off until you explicitly approve a listening session."/>
                </StackPanel>
                <Button Content="×" DockPanel.Dock="Right" Style="{StaticResource DarkButton}" Padding="8,1" FontSize="14"
                        ToolTip="Hide chat" Click="HideButton_Click"/>
            </DockPanel>

            <!-- Keep the emergency stop permanently accessible. Diagnostics
                 and camera controls are optional, not a permanent 150px header. -->
            <Border Grid.Row="1" Background="{StaticResource SurfaceBg}" CornerRadius="10" Padding="8,6" Margin="0,0,0,7"
                    BorderBrush="#334A4060" BorderThickness="1">
                <DockPanel LastChildFill="True">
                    <Button DockPanel.Dock="Right" Content="STOP task" Style="{StaticResource DarkButton}"
                            Margin="8,0,0,0" Padding="8,5"
                            ToolTip="Emergency stop: immediately latch task stop via shared authority"
                            Command="{Binding EmergencyStopCommand}"/>
                    <StackPanel>
                        <TextBlock Text="{Binding ModelStatus}" FontSize="12"
                                   Foreground="{StaticResource EyeBlue}" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding StatusText}" FontSize="11"
                                   Foreground="{StaticResource TextDim}" TextWrapping="Wrap"/>
                        <TextBlock x:Name="VoiceTip" Text="Wake word is OFF until you press Start mic or use the avatar's right-click menu."
                                   FontSize="10" Foreground="{StaticResource FaceGreen}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                        <TextBlock Text="{Binding Ambient.StatusText}" FontSize="10"
                                   Foreground="{StaticResource TextDim}" TextWrapping="Wrap"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <Expander Grid.Row="2" Header="More controls: task status and webcam"
                      IsExpanded="False" Foreground="{StaticResource TextDim}"
                      Margin="0,0,0,7" FontSize="11">
                <Border Background="#33201A2D" BorderBrush="#664D98A6"
                        BorderThickness="1" CornerRadius="8" Padding="8" Margin="0,5,0,0">
                    <StackPanel>
                        <TextBlock Text="{Binding AuthorityStatus}" FontSize="11"
                                   Foreground="{StaticResource TextDim}" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding ActiveTaskStatus}" FontSize="11"
                                   Foreground="{StaticResource TextDim}" TextWrapping="Wrap"/>
                        <WrapPanel Margin="0,6,0,10">
                            <Button Content="Reset stop" Style="{StaticResource DarkButton}"
                                    Margin="0,0,5,0"
                                    ToolTip="Reset the task emergency-stop latch for future tasks"
                                    Command="{Binding ResetTaskStopCommand}"/>
                            <Button Content="Start local AI (Ollama)" Style="{StaticResource DarkButton}"
                                    Margin="0" Click="StartOllama_Click"
                                    ToolTip="Start the installed local Ollama server with your permission"/>
                        </WrapPanel>
                        <TextBlock Text="WEBCAM (opt-in)" FontSize="11"
                                   FontWeight="SemiBold" Foreground="{StaticResource FaceGreen}"/>
                        <TextBlock Text="{Binding Ambient.StatusText}" FontSize="11"
                                   Foreground="{StaticResource TextDim}" TextWrapping="Wrap" Margin="0,3,0,7"/>
                        <WrapPanel>
                            <Button Content="Start camera" Style="{StaticResource DarkButton}" Padding="7,4" Margin="0,0,4,4"
                                    ToolTip="Requires separate webcam consent for each session" Click="StartCamera_Click"/>
                            <Button Content="Pause" Style="{StaticResource DarkButton}" Padding="7,4" Margin="0,0,4,4"
                                    Click="PauseCamera_Click"/>
                            <Button Content="Resume" Style="{StaticResource DarkButton}" Padding="7,4" Margin="0,0,4,4"
                                    Click="ResumeCamera_Click"/>
                            <Button Content="Stop camera" Style="{StaticResource DarkButton}" Padding="7,4" Margin="0,0,4,4"
                                    Click="StopCamera_Click"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>
            </Expander>

            <Border Grid.Row="3" Background="{StaticResource SurfaceBg}" CornerRadius="10" BorderBrush="#334A4060" BorderThickness="1">
                <ScrollViewer x:Name="MessagesScroll" VerticalScrollBarVisibility="Auto" Padding="8">
                    <ItemsControl ItemsSource="{Binding Messages}"/>
                </ScrollViewer>
            </Border>

            <ProgressBar Grid.Row="4" Height="3" Margin="0,6,0,4" IsIndeterminate="True"
                         Foreground="{StaticResource Magenta}" Background="#22FFFFFF" BorderThickness="0"
                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>

            <Grid Grid.Row="5" Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="InputBox"
                         Grid.Column="0"
                         Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         MinHeight="40" MaxHeight="84"
                         VerticalScrollBarVisibility="Auto"
                         PreviewKeyDown="InputBox_PreviewKeyDown"
                         Margin="0,0,6,0"
                         Background="{StaticResource InputBg}"
                         Foreground="{StaticResource TextMain}"
                         CaretBrush="{StaticResource TextMain}"
                         BorderBrush="#55FF176C"
                         BorderThickness="1"
                         Padding="8,6"/>
                <Button Grid.Column="1" x:Name="MicButton" Content="Start mic" Style="{StaticResource IconButton}" Margin="0,0,6,0" ToolTip="Start/stop offline microphone session; requires consent" Click="MicButton_Click"/>
                <Button Grid.Column="2" Content="Send" Style="{StaticResource DarkButton}" Margin="0,0,6,0"
                        Command="{Binding SendCommand}"/>
                <Button Grid.Column="3" Content="Stop" Style="{StaticResource DarkButton}" ToolTip="Stop current response"
                        Command="{Binding CancelCommand}"/>
            </Grid>
        </Grid>
    </Border>
</Window>
