<Window x:Class="Capri.Desktop.Views.ChatPanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Capri.Desktop.ViewModels"
        mc:Ignorable="d"
        Title="Capri Chat"
        Width="390" Height="555"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ShowActivated="True"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        Visibility="Collapsed"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <SolidColorBrush x:Key="PanelBg" Color="#E6101015"/>
        <SolidColorBrush x:Key="SurfaceBg" Color="#CC1A1822"/>
        <SolidColorBrush x:Key="InputBg" Color="#F0151320"/>
        <SolidColorBrush x:Key="Magenta" Color="#FF176C"/>
        <SolidColorBrush x:Key="FaceGreen" Color="#00FF65"/>
        <SolidColorBrush x:Key="EyeBlue" Color="#388FFF"/>
        <SolidColorBrush x:Key="Outline" Color="#150B19"/>
        <SolidColorBrush x:Key="TextMain" Color="#F8F5FF"/>
        <SolidColorBrush x:Key="TextDim" Color="#B8B0C8"/>

        <Style x:Key="DarkButton" TargetType="Button">
            <Setter Property="Background" Value="#2A2235"/>
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
            <Setter Property="BorderBrush" Value="#55FF176C"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#AAFF176C"/>
                                <Setter TargetName="Bd" Property="Background" Value="#352844"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#442D55"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource DarkButton}">
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="MinWidth" Value="34"/>
            <Setter Property="ToolTipService.InitialShowDelay" Value="300"/>
        </Style>

        <DataTemplate DataType="{x:Type vm:ChatMessageViewModel}">
            <Border Margin="0,4" Padding="9,7" CornerRadius="10" MaxWidth="300">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="#CC232033"/>
                        <Setter Property="BorderBrush" Value="#334A4060"/>
                        <Setter Property="BorderThickness" Value="1"/>
                        <Setter Property="HorizontalAlignment" Value="Left"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Role}" Value="You">
                                <Setter Property="Background" Value="#55388FFF"/>
                                <Setter Property="BorderBrush" Value="#77388FFF"/>
                                <Setter Property="HorizontalAlignment" Value="Right"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsError}" Value="True">
                                <Setter Property="Background" Value="#44FF176C"/>
                                <Setter Property="BorderBrush" Value="#88FF176C"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock Text="{Binding Role}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource FaceGreen}" Opacity="0.9"/>
                    <TextBox Text="{Binding Text, Mode=OneWay}" TextWrapping="Wrap" IsReadOnly="True"
                             BorderThickness="0" Background="Transparent" Foreground="{StaticResource TextMain}"
                             Padding="0" Margin="0,2,0,0" IsReadOnlyCaretVisible="False" CaretBrush="{StaticResource TextMain}"/>
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Border CornerRadius="16" Background="{StaticResource PanelBg}" BorderBrush="#99FF176C" BorderThickness="1.5" Padding="10">
        <Border.Effect>
            <DropShadowEffect Color="#FF176C" BlurRadius="14" ShadowDepth="0" Opacity="0.18"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" Margin="0,0,0,6">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <Ellipse Width="8" Height="8" Fill="{StaticResource FaceGreen}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Capri" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextMain}"/>
                </StackPanel>
                <Button Content="×" DockPanel.Dock="Right" Style="{StaticResource DarkButton}" Padding="8,1" FontSize="14"
                        ToolTip="Hide chat" Click="HideButton_Click"/>
            </DockPanel>

            <Border Grid.Row="1" Background="{StaticResource SurfaceBg}" CornerRadius="10" Padding="8,6" Margin="0,0,0,8"
                    BorderBrush="#334A4060" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="{Binding ModelStatus}" FontSize="11" Foreground="{StaticResource EyeBlue}" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding AuthorityStatus}" FontSize="10" Foreground="{StaticResource TextDim}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding ActiveTaskStatus}" FontSize="10" Foreground="{StaticResource TextDim}" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding StatusText}" FontSize="11" Foreground="{StaticResource TextDim}" Margin="0,1,0,0" TextWrapping="Wrap"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,2,0,0">
                        <Button Content="STOP task" Style="{StaticResource DarkButton}" ToolTip="Latch emergency task stop via shared authority when available" Command="{Binding EmergencyStopCommand}"/>
                        <Button Content="Reset stop" Style="{StaticResource DarkButton}" Margin="5,0,0,0" ToolTip="Explicitly reset task stop for future tasks" Command="{Binding ResetTaskStopCommand}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Grid.Row="2" Background="#33201A2D" BorderBrush="#664D98A6"
                    BorderThickness="1" CornerRadius="8" Padding="7" Margin="0,0,0,7">
                <StackPanel>
                    <TextBlock Text="AMBIENT COMPANION / WEBCAM" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource FaceGreen}"/>
                    <TextBlock Text="{Binding Ambient.StatusText}" FontSize="10" TextWrapping="Wrap"
                               Foreground="{StaticResource TextDim}" Margin="0,2,0,5"/>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Start camera" Style="{StaticResource DarkButton}" Padding="7,4" Margin="0,0,4,0"
                                ToolTip="Requires a separate camera consent dialog each session" Click="StartCamera_Click"/>
                        <Button Content="Pause" Style="{StaticResource DarkButton}" Padding="7,4" Margin="0,0,4,0"
                                Click="PauseCamera_Click"/>
                        <Button Content="Resume" Style="{StaticResource DarkButton}" Padding="7,4" Margin="0,0,4,0"
                                Click="ResumeCamera_Click"/>
                        <Button Content="Stop" Style="{StaticResource DarkButton}" Padding="7,4"
                                Click="StopCamera_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Grid.Row="3" Background="{StaticResource SurfaceBg}" CornerRadius="10" BorderBrush="#334A4060" BorderThickness="1">
                <ScrollViewer x:Name="MessagesScroll" VerticalScrollBarVisibility="Auto" Padding="8">
                    <ItemsControl ItemsSource="{Binding Messages}"/>
                </ScrollViewer>
            </Border>

            <ProgressBar Grid.Row="4" Height="3" Margin="0,6,0,4" IsIndeterminate="True"
                         Foreground="{StaticResource Magenta}" Background="#22FFFFFF" BorderThickness="0"
                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>

            <Grid Grid.Row="5" Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="InputBox"
                         Grid.Column="0"
                         Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         MinHeight="40" MaxHeight="84"
                         VerticalScrollBarVisibility="Auto"
                         PreviewKeyDown="InputBox_PreviewKeyDown"
                         Margin="0,0,6,0"
                         Background="{StaticResource InputBg}"
                         Foreground="{StaticResource TextMain}"
                         CaretBrush="{StaticResource TextMain}"
                         BorderBrush="#55FF176C"
                         BorderThickness="1"
                         Padding="8,6"/>
                <Button Grid.Column="1" x:Name="MicButton" Content="🎤" Style="{StaticResource IconButton}" Margin="0,0,6,0"
                        ToolTip="Microphone (placeholder)" Click="MicButton_Click"/>
                <Button Grid.Column="2" Content="Send" Style="{StaticResource DarkButton}" Margin="0,0,6,0"
                        Command="{Binding SendCommand}"/>
                <Button Grid.Column="3" Content="Stop" Style="{StaticResource DarkButton}" ToolTip="Stop current response"
                        Command="{Binding CancelCommand}"/>
            </Grid>
        </Grid>
    </Border>
</Window>
