<Window x:Class="Capri.Desktop.Views.DeveloperWorkspaceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Capri — Developer Workspace"
        Width="740" Height="540" MinWidth="560" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        Background="#101015" Foreground="#F8F5FF">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#30273D"/>
            <Setter Property="Foreground" Value="#F8F5FF"/>
            <Setter Property="BorderBrush" Value="#6655FF9D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock Text="DEVELOPER WORKSPACE" Foreground="#00FF65"
                       FontSize="13" FontWeight="Bold"/>
            <TextBlock Text="Your projects, ready for a shared GUI + TUI"
                       Foreground="#F8F5FF" FontSize="23"
                       FontWeight="SemiBold" Margin="0,6,0,4"/>
            <TextBlock Text="Save a project folder without granting Capri permission to read or edit its code."
                       Foreground="#B8B0C8" TextWrapping="Wrap" FontSize="13"/>
        </StackPanel>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
            <Button Content="+ Add project folder" Click="AddProject_Click"/>
            <Button Content="Refresh" Click="Refresh_Click"/>
        </StackPanel>
        <TextBlock Grid.Row="2" x:Name="StatusMessage" Text="Select a project folder to create a local session bookmark."
                   Foreground="#B8B0C8" TextWrapping="Wrap" Margin="0,0,0,10"/>
        <ListBox Grid.Row="3" x:Name="SessionList"
                 Background="#1A1822" Foreground="#F8F5FF"
                 BorderBrush="#554A4060" BorderThickness="1"
                 HorizontalContentAlignment="Stretch" Padding="5">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Background="#221F2D" CornerRadius="8" Padding="12" Margin="0,4">
                        <StackPanel>
                            <TextBlock Text="{Binding DisplayName}"
                                       FontWeight="SemiBold" FontSize="15"/>
                            <TextBlock Text="{Binding WorkspaceDirectory}"
                                       FontSize="12" Foreground="#B8B0C8"
                                       TextWrapping="Wrap" Margin="0,5,0,0"/>
                            <TextBlock Text="{Binding Id}"
                                       FontSize="10" Foreground="#82A4CC"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <Grid Grid.Row="4" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0"
                       Text="Coding, terminal commands and AI project access are not enabled by this screen."
                       Foreground="#B8B0C8" TextWrapping="Wrap"
                       VerticalAlignment="Center" Margin="0,0,16,0"/>
            <Button Grid.Column="1" Content="Close" Click="Close_Click" Margin="0"/>
        </Grid>
    </Grid>
</Window>
