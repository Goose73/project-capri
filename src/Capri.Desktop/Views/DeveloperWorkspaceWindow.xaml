<Window x:Class="Capri.Desktop.Views.DeveloperWorkspaceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Capri — Developer Workspace"
        Width="1010" Height="690" MinWidth="750" MinHeight="540"
        WindowStartupLocation="CenterOwner"
        Background="#101015" Foreground="#F8F5FF">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#30273D"/>
            <Setter Property="Foreground" Value="#F8F5FF"/>
            <Setter Property="BorderBrush" Value="#6655FF9D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#1A1822"/>
            <Setter Property="Foreground" Value="#F8F5FF"/>
            <Setter Property="BorderBrush" Value="#554A4060"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Foreground" Value="#F8F5FF"/>
        </Style>
    </Window.Resources>
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="DEVELOPER WORKSPACE" Foreground="#00FF65"
                       FontSize="13" FontWeight="Bold"/>
            <TextBlock Text="Your projects and conversations"
                       FontSize="23" FontWeight="SemiBold" Margin="0,4,0,2"/>
            <TextBlock Text="Developer mode shares local project bookmarks and chat across the GUI and CLI. Coding tools are not enabled yet."
                       Foreground="#B8B0C8" FontSize="12"/>
        </StackPanel>
        <TextBlock Grid.Row="1" x:Name="StatusMessage"
                   Text="Select or add a project to begin."
                   Foreground="#82A4CC" FontSize="12" Margin="0,0,0,10"/>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="270"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Margin="0,0,0,8">
                    <TextBlock Text="PROJECTS" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <WrapPanel>
                        <Button Content="+ Add folder" Click="AddProject_Click"/>
                        <Button Content="Refresh" Click="Refresh_Click"/>
                    </WrapPanel>
                </StackPanel>
                <ListBox Grid.Row="1" x:Name="SessionList"
                         SelectionChanged="SessionList_SelectionChanged"
                         Background="#1A1822" Foreground="#F8F5FF"
                         BorderBrush="#554A4060" BorderThickness="1"
                         HorizontalContentAlignment="Stretch" Padding="5">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#221F2D" CornerRadius="7" Padding="10" Margin="0,3">
                                <StackPanel>
                                    <TextBlock Text="{Binding DisplayName}"
                                               FontWeight="SemiBold" FontSize="14"/>
                                    <TextBlock Text="{Binding WorkspaceDirectory}"
                                               FontSize="11" Foreground="#B8B0C8"
                                               TextWrapping="Wrap" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
            <TabControl Grid.Column="2" Background="#1A1822" Foreground="#F8F5FF"
                        BorderBrush="#554A4060">
                <TabItem Header="Conversation">
                    <Grid Margin="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Margin="0,0,0,9"
                                   FontSize="12" Foreground="#B8B0C8"
                                   Text="Conversation text is encrypted locally. Your AI provider receives typed messages; cloud providers can receive data externally. Files are NEVER included unless you select one and explicitly confirm its upload."/>
                        <TextBox Grid.Row="1" x:Name="ConversationBox"
                                 IsReadOnly="True" AcceptsReturn="True"
                                 FontFamily="Consolas" FontSize="12"
                                 VerticalScrollBarVisibility="Auto"/>
                        <StackPanel Grid.Row="2" Margin="0,9,0,8">
                            <TextBox x:Name="MessageInput" Height="72" AcceptsReturn="True"
                                     ToolTip="Enter the message you want to send to your configured AI model."/>
                            <CheckBox x:Name="AttachSourceCheckbox" Margin="0,8,0,3"
                                      IsChecked="False" IsEnabled="False"
                                      Foreground="#F8F5FF">
                                <TextBlock Text="Include selected source file in this one AI question (asks again before sending)"
                                           TextWrapping="Wrap" Foreground="#F8F5FF"/>
                            </CheckBox>
                            <TextBlock x:Name="SelectedSourceText" Text="No source file selected. Preview a file in the project files tab first."
                                       FontSize="11" Foreground="#B8B0C8"/>
                        </StackPanel>
                        <WrapPanel Grid.Row="3">
                            <Button x:Name="SendButton" Content="Send to AI" Click="Send_Click"/>
                            <Button Content="Stop response" Click="CancelReply_Click"/>
                            <Button Content="Reload history" Click="ReloadHistory_Click"/>
                        </WrapPanel>
                    </Grid>
                </TabItem>
                <TabItem Header="Read-only project files">
                    <Grid Margin="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="145"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" FontSize="12" Foreground="#B8B0C8"
                                   Margin="0,0,0,10"
                                   Text="Nothing is browsed automatically. Approve local read access and preview an eligible file. To share it with AI, return to Conversation, check the source box and approve the separate send confirmation. Only one file, up to 8,000 characters, can be shared per question."/>
                        <DockPanel Grid.Row="1" Margin="0,0,0,9">
                            <Button DockPanel.Dock="Right" Content="Browse folder" Click="BrowseFolder_Click" Margin="8,0,0,0"/>
                            <TextBox x:Name="RelativeFolderBox" ToolTip="Relative folder inside selected project; leave empty for root."/>
                        </DockPanel>
                        <ListBox Grid.Row="2" x:Name="ProjectItemsList"
                                 DisplayMemberPath="RelativePath"
                                 Background="#221F2D" Foreground="#F8F5FF"
                                 BorderBrush="#554A4060"/>
                        <WrapPanel Grid.Row="3" Margin="0,9,0,9">
                            <Button Content="Open selected subfolder" Click="OpenFolder_Click"/>
                            <Button Content="Preview selected file" Click="PreviewFile_Click"/>
                        </WrapPanel>
                        <TextBox Grid.Row="4" x:Name="FilePreviewBox"
                                 IsReadOnly="True" FontFamily="Consolas"
                                 FontSize="12" AcceptsReturn="True"
                                 ToolTip="Source preview stays local and is never attached to chat automatically."/>
                    </Grid>
                </TabItem>
            </TabControl>
        </Grid>
        <DockPanel Grid.Row="3" Margin="0,12,0,0">
            <Button Content="Close" DockPanel.Dock="Right" Click="Close_Click" Margin="0"/>
            <TextBlock VerticalAlignment="Center" FontSize="11" Foreground="#B8B0C8"
                       Text="No automatic file editing, shell execution, or privileged tool access."/>
        </DockPanel>
    </Grid>
</Window>
