<UserControl x:Class="Capri.Desktop.Controls.AvatarControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="240" d:DesignHeight="300"
             SnapsToDevicePixels="True" UseLayoutRounding="True" Background="Transparent">
    <Grid x:Name="Root" Background="Transparent">
        <!-- Artwork-first renderer: displays transparent Capri sprite assets when provided.
             Do NOT draw Capri with basic WPF shapes. See design/CAPRI-ASSET-SPEC.md. -->
        <Grid x:Name="SpriteHost" RenderTransformOrigin="0.5,0.9">
            <Grid.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="MotionScale" ScaleX="1" ScaleY="1"/>
                    <TranslateTransform x:Name="MotionTranslate" X="0" Y="0"/>
                    <RotateTransform x:Name="MotionRotate" Angle="0"/>
                </TransformGroup>
            </Grid.RenderTransform>
            <Image x:Name="AvatarImage"
                   Stretch="Uniform"
                   RenderOptions.BitmapScalingMode="HighQuality"
                   Visibility="Collapsed"
                   IsHitTestVisible="True"/>
            <Border x:Name="AssetPlaceholder"
                    Visibility="Visible"
                    Background="#CC101015"
                    BorderBrush="#FF176C"
                    BorderThickness="2"
                    CornerRadius="10"
                    Padding="12"
                    MaxWidth="240"
                    IsHitTestVisible="True">
                <StackPanel>
                    <TextBlock Text="Capri artwork asset required"
                               Foreground="#F8F5FF"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"/>
                    <TextBlock Text="Add a transparent illustrated sprite (min 1024px tall) to design/assets/capri/idle.png. Current geometric avatar rejected."
                               Foreground="#C8F8F5FF"
                               Margin="0,6,0,0"
                               FontSize="11"
                               TextWrapping="Wrap"/>
                    <TextBlock Text="See design/CAPRI-ASSET-SPEC.md"
                               Foreground="#388FFF"
                               Margin="0,6,0,0"
                               FontSize="11"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
